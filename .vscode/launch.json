{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Probe-rs Debug",
      "preLaunchTask": "CMake: build with preset",
      "cwd": "${workspaceFolder}",
      "chip": "STM32F103ZETx",
      "flashingConfig": {
        "flashingEnabled": true,
        "verifyAfterFlashing": true
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/build/f103-hal/stm32-template.elf",
          "svdFile": "${workspaceFolder}/svd/STM32F103.svd"
        }
      ]
    }
  ]
}
