{
  "version": 3,
  "configurePresets": [
    {
      "name": "f103-hal",
      "displayName": "STM32F103 (HAL Driver)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/f103-hal",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BOARD": "ATK_WARSHIP_F103",
        "STM32_DRIVER_TYPE": "HAL",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "host-test",
      "displayName": "Host PC Unit Tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "f103-hal-lab1-1-led",
      "displayName": "Lab1.1: Led Blinking",
      "configurePreset": "f103-hal",
      "jobs": 0,
      "targets": ["stm32_learning_lab1_1_led"]
    },
    {
      "name": "f103-hal-lab1-2-led-chaser",
      "displayName": "Lab1.2: Led Chaser",
      "configurePreset": "f103-hal",
      "jobs": 0,
      "targets": ["stm32_learning_lab1_2_led_chaser"]
    },
    {
      "name": "f103-hal-lab2-1-key2led",
      "displayName": "Lab2.1: Control Led with Key",
      "configurePreset": "f103-hal",
      "jobs": 0,
      "targets": ["stm32_learning_lab2_1_key2led"]
    },
    {
      "name": "f103-hal-lab2-2-keyit2led",
      "displayName": "Lab2.2: Control Led with Key through Interrupt",
      "configurePreset": "f103-hal",
      "jobs": 0,
      "targets": ["stm32_learning_lab2_2_keyit2led"]
    },
    {
      "name": "f103-hal-lab2-3-key2buzzer",
      "displayName": "Lab2.3: Control Buzzer with Key",
      "configurePreset": "f103-hal",
      "jobs": 0,
      "targets": ["stm32_learning_lab2_3_key2buzzer"]
    },
    {
      "name": "host-test",
      "displayName": "Host PC Unit Tests (Build)",
      "description": "Build all unit tests on host",
      "configurePreset": "host-test"
    }
  ],
  "testPresets": [
    {
      "name": "host-test",
      "displayName": "Run Host Unit Tests",
      "description": "Run unit test suite via CTest on host PC",
      "configurePreset": "host-test",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
